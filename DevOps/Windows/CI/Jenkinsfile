pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS=credentials('lab_big_data_two')
        LC_ALL = "en_US.UTF-8"
        LANG    = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Clone github repository') {
            steps {
                cleanWs()
                bat 'chcp 65001 && git clone -b develop https://github.com/Lammirea/mlops-project.git'
            }
        }

        stage('Checkout repo dir') {
            steps {
                bat 'chcp 65001 && cd mlops-project && dir'
            }
        }

        stage('Decrypt .env via Ansible') {
            steps {
                dir('mlops-project') {
                    // ansible_vault_password должен быть добавлен в Jenkins Credentials (type: Secret text)
                    withCredentials([string(credentialsId: 'ansible_vault_password', variable: 'VAULT_PASS')]) {
                        bat '''
                            chcp 65001
                            setlocal enabledelayedexpansion

                            REM --- Убедимся, что директория infra/ansible есть (на всякий случай)
                            if not exist infra\\ansible mkdir infra\\ansible
                            if not exist infra\\ansible\\playbooks mkdir infra\\ansible\\playbooks
                            if not exist infra\\ansible\\group_vars mkdir infra\\ansible\\group_vars
                            if not exist infra\\ansible\\group_vars\\all mkdir infra\\ansible\\group_vars\\all

                            REM --- создаём временный файл с паролем для ansible-vault (удалим позже)
                            echo %VAULT_PASS% > infra\\ansible\\.vault_pass.txt

                            REM --- Запускаем Docker-контейнер на базе python и устанавливаем ansible через pip, затем запускаем playbook
                            REM --- Монтируем текущую директорию в /app и используем /work/infra/ansible/ansible.cfg
                            docker run --rm -v "%cd%":/app -w /app -e ANSIBLE_CONFIG=/work/infra/ansible/ansible.cfg python:3.11-bullseye bash -lc ^
                                "python -m pip install --upgrade pip setuptools wheel >/dev/null && ^
                                 pip install ansible >/dev/null && ^
                                 ansible-playbook infra/ansible/playbooks/deploy_env.yml --vault-password-file infra/ansible/.vault_pass.txt"

                            REM --- Удаляем временный файл пароля
                            del infra\\ansible\\.vault_pass.txt

                            endlocal
                        '''
                    }
                }
            }
        }

        stage('Setup MinIO and DVC') {
            steps {
                dir('mlops-project') {
                    withCredentials([
                        string(credentialsId: 'minio-access-key', variable: 'MINIO_ACCESS_KEY'),
                        string(credentialsId: 'minio-secret-key', variable: 'MINIO_SECRET_KEY'),
                        string(credentialsId: 'minio-endpoint', variable: 'MINIO_ENDPOINT')
                    ]) {
                        // 1) Создаём .env (добавляем MinIO настройки)
                        bat '''
                            chcp 65001
                            REM --- создаем .env с параметрами MinIO
                            echo MINIO_ACCESS_KEY=%MINIO_ACCESS_KEY% >> .env
                            echo MINIO_SECRET_KEY=%MINIO_SECRET_KEY% >> .env
                            echo MINIO_ENDPOINT=%MINIO_ENDPOINT% >> .env
                            echo DVC_REMOTE_NAME=storage >> .env
                        '''

                        // 2) Запускаем minio и init контейнер
                        bat '''
                            chcp 65001
                            REM --- запускаем MinIO и init
                            docker-compose up -d minio minio-init
                        '''

                        // 3) Ждём старт контейнеров: заменяем timeout (не работает под службой) на ping
                        bat '''
                            chcp 65001
                            REM --- Подождать ~30 секунд (ping вместо timeout, чтобы не падало в non-interactive)
                            ping -n 31 127.0.0.1 >nul
                        '''

                        // 4) (опционально/рекомендовано) Проводим проверку, что MinIO слушает порт 9000 внутри сети compose
                        //    Если нужно — можно заменить на более точный polling по HTTP (curl) или использовать mc client.
                        bat '''
                            chcp 65001
                            REM --- Простейшая проверка: убедиться, что контейнер minio запущен
                            docker ps -a --filter "name=mlops-project-minio-1" --format "table {{.Names}}\\t{{.Status}}"
                        '''

                        // 5) Устанавливаем dvc и инициализируем (в контейнере python)
                        bat '''
                            chcp 65001
                            docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -lc "python -m pip install --upgrade pip setuptools wheel && pip install dvc[s3]"
                        '''

                        bat '''
                            chcp 65001
                            docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -lc "cd /app && dvc init --no-scm"
                        '''

                        bat '''
                            chcp 65001
                            docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -lc "cd /app && dvc remote add -d storage s3://data && dvc remote modify storage endpointurl %MINIO_ENDPOINT% && dvc remote modify storage access_key_id %MINIO_ACCESS_KEY% && dvc remote modify storage secret_access_key %MINIO_SECRET_KEY% && echo 'DVC setup completed'"
                        '''
                    }
                }
            }
        }


        stage('Run Unit Tests (in Docker)') {
            steps {
                dir('mlops-project') {
                bat '''
                    chcp 65001
                    docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -c " \
                    python -m pip install --upgrade pip setuptools wheel && \
                    pip install -r requirements.txt coverage pytest dvc[s3] --root-user-action=ignore && \
                    coverage run -m pytest src/unit_tests -q --maxfail=1 --disable-warnings && \
                    coverage xml -i && \
                    coverage html -d coverage_html \
                    "
                '''
                }
            }
        }

        stage('Login'){
            steps{
                bat 'chcp 65001 && docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
            }
        }

        stage('Create and run docker container') {
            steps {
                script {
                    try {
                        bat 'chcp 65001 && cd mlops-project && docker-compose build'
                    }
                    finally {
                        dir('mlops-project') {
                            withCredentials([
                                string(credentialsId: 'postgres-password', variable: 'POSTGRES_PASSWORD'),
                                string(credentialsId: 'postgres-host', variable: 'POSTGRES_HOST'),
                                string(credentialsId: 'postgres-port', variable: 'POSTGRES_PORT'),
                                string(credentialsId: 'postgres-db', variable: 'POSTGRES_DB'),
                                string(credentialsId: 'postgres-user', variable: 'POSTGRES_USER')
                            ]) {
                                bat '''
                                    chcp 65001
                                    REM --- дописываем параметры postgresql в .env
                                    echo POSTGRES_HOST=%POSTGRES_HOST% >> .env
                                    echo POSTGRES_PORT=%POSTGRES_PORT% >> .env
                                    echo POSTGRES_DB=%POSTGRES_DB% >> .env
                                    echo POSTGRES_USER=%POSTGRES_USER% >> .env
                                    echo POSTGRES_PASSWORD=%POSTGRES_PASSWORD% >> .env
                                    docker-compose up -d
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Checkout container logs') {
            steps {
                dir("mlops-project") {
                    bat '''
                        docker-compose up -d
                        for /f %%i in ('docker ps -qf "name=^mlops-project-web-1"') do set containerId=%%i
                        echo %containerId%
                        IF "%containerId%" == "" (
                            echo "No container running"
                        )
                        ELSE (
                            docker logs --tail 1000 %containerId%
                        )
                    '''
                }
            }
        }

        stage('Checkout coverage report') {
            steps {
                dir('mlops-project') {
                bat 'chcp 65001 && type coverage.xml || echo "coverage.xml not found"'
                publishHTML (target: [
                    reportDir: 'coverage_html',
                    reportFiles: 'index.html',
                    reportName: 'Coverage Report',
                    keepAll: true
                ])
                }
            }
        }

        stage('Push'){
            steps{
                bat 'chcp 65001 && docker push derelia/mlops-project:latest'
            }
        }
    }

    post {
        always {
            bat '''
                chcp 65001
                docker stop mlops-project-web-1 || exit /b 0
                docker rm mlops-project-web-1 || exit /b 0
                docker stop postgres || exit /b 0
                docker rm postgres || exit /b 0
                docker stop minio || exit /b 0
                docker rm minio || exit /b 0
                docker stop mlops-project-minio-init-1 || exit /b 0
                docker rm mlops-project-minio-init-1 || exit /b 0
                docker rmi derelia/mlops-project:latest || exit /b 0
                docker rmi postgres:latest || exit /b 0
                docker rmi minio/minio:latest || exit /b 0
                docker rmi minio/mc:latest || exit /b 0
                docker logout
            '''
            cleanWs()
        }
    }
}