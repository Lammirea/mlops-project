pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS=credentials('lab_big_data_two')
        LC_ALL = "en_US.UTF-8"
        LANG    = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
    }

    options {
        timestamps()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Clone github repository') {
            steps {
                cleanWs()
                bat 'chcp 65001 && git clone -b develop https://github.com/Lammirea/mlops-project.git'
            }
        }

        stage('Checkout repo dir') {
            steps {
                bat 'chcp 65001 && cd mlops_project && dir'
            }
        }

        stage('Decrypt ansible-vault files') {
            // Делаем расшифровку один раз для всего pipeline (тесты + docker-compose)
            steps {
                dir('mlops_project') {
                    // Рекомендуемый вариант: используем Secret file (credentialsId = 'ansible-vault-pass-file')
                    withCredentials([file(credentialsId: 'vault-pass-id', variable: 'VAULT_PASS_FILE')]) {
                        bat '''
                            chcp 65001

                            REM копируем секретный файл (Jenkins дает путь на агенте) в workspace
                            copy "%VAULT_PASS_FILE%" vault_pass.txt

                            REM создаем скрипт decrypt.sh, который потом выполнится внутри Linux-контейнера
                            echo #!/bin/bash > decrypt.sh
                            REM экранируем > в Windows командном интерпретаторе с ^
                            echo ansible-vault view --vault-password-file vault_pass.txt .env.vault ^> .env >> decrypt.sh
                            REM сделаем скрипт исполняемым не нужно — запустим через bash

                            REM запускаем Linux-контейнер; внутри него ставим ansible-core и выполняем decrypt.sh
                            docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -lc "pip install --upgrade pip setuptools wheel ansible-core && bash ./decrypt.sh"

                            REM удаляем временные артефакты
                            del /Q vault_pass.txt || echo no vault_pass.txt
                            del /Q decrypt.sh || echo no decrypt.sh
                        '''
                    }
                }
            }
        }

        stage('Run Unit Tests (in Docker)') {
            steps {
                dir('mlops_project') {
                bat '''
                    chcp 65001
                    docker run --rm -v "%cd%":/app -w /app python:3.11-bullseye bash -lc " \
                    python -m pip install --upgrade pip setuptools wheel && \
                    pip install -r requirements.txt coverage pytest --root-user-action=ignore && \
                    coverage run -m pytest src/unit_tests -q --maxfail=1 --disable-warnings && \
                    coverage xml -i && \
                    coverage html -d coverage_html \
                    "
                '''
                }
            }
        }


        stage('Login'){
            steps{
                bat 'chcp 65001 && docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
            }
        }

        stage('Create and run docker container') {
            steps {
                script {
                    try {
                        bat 'chcp 65001 && cd mlops_project && docker-compose build'
                    }
                    finally {
                        dir('mlops_project') {
                            withCredentials([
                                string(credentialsId: 'postgres-password', variable: 'POSTGRES_PASSWORD'),
                                string(credentialsId: 'postgres-host', variable: 'POSTGRES_HOST'),
                                string(credentialsId: 'postgres-port', variable: 'POSTGRES_PORT'),
                                string(credentialsId: 'postgres-db', variable: 'POSTGRES_DB'),
                                string(credentialsId: 'postgres-user', variable: 'POSTGRES_USER')
                            ]) {
                                bat '''
                                    chcp 65001
                                    REM --- дописываем параметры postgresql в .env (уже расшифрована или создана ранее)
                                    echo POSTGRES_HOST=%POSTGRES_HOST% >> .env
                                    echo POSTGRES_PORT=%POSTGRES_PORT% >> .env
                                    echo POSTGRES_DB=%POSTGRES_DB% >> .env
                                    echo POSTGRES_USER=%POSTGRES_USER% >> .env
                                    echo POSTGRES_PASSWORD=%POSTGRES_PASSWORD% >> .env
                                    docker-compose up -d
                                '''
                            }
                        }
                    }
                }
            }
        }

        stage('Checkout container logs') {
            steps {
                dir("mlops_project") {
                    bat '''
                        docker-compose up -d
                        for /f %%i in ('docker ps -qf "name=^mlops_project-web-1"') do set containerId=%%i
                        echo %containerId%
                        IF "%containerId%" == "" (
                            echo "No container running"
                        )
                        ELSE (
                            docker logs --tail 1000 %containerId%
                        )
                    '''
                }
            }
        }

        stage('Checkout coverage report') {
            steps {
                dir('mlops_project') {
                // просто вывести краткую сводку
                bat 'chcp 65001 && type coverage.xml || echo "coverage.xml not found"'
                // или лучше: опубликовать html через плагин Publish HTML
                publishHTML (target: [
                    reportDir: 'coverage_html',
                    reportFiles: 'index.html',
                    reportName: 'Coverage Report',
                    keepAll: true
                ])
                }
            }
        }


        stage('Push'){
            steps{
                bat 'chcp 65001 && docker push derelia/mlops_project:latest'
            }
        }
    }

    post {
        always {
            bat '''
                chcp 65001
                docker stop mlops_project-web-1 || exit /b 0
                docker rm mlops_project-web-1 || exit /b 0
                docker stop postgres_db || exit /b 0
                docker rm postgres_db || exit /b 0
                docker rmi derelia/mlops_project:latest || exit /b 0
                docker rmi postgres:latest || exit /b 0
                docker logout
            '''
            cleanWs()
        }
    }
}